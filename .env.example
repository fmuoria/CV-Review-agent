# Copy to .env and fill in. Only DATABASE_URL is needed to try the app locally.

APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://ats:ats@localhost:5432/ats?sslmode=disable
# 32+ random characters. Required in production. Keep it stable: it encrypts the Gmail connection.
APP_SECRET=

# --- Google sign-in (OAuth client, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=sinapis.org
ADMIN_EMAILS=you@sinapis.org

# --- AI ---  demo | vertex | gemini
LLM_PROVIDER=demo
LLM_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Either paste the service-account key JSON here, or point to the file.
# On your laptop you can instead run: gcloud auth application-default login
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Only for LLM_PROVIDER=gemini (AI Studio). Use a PAID key: free-tier prompts may be used to train Google's models.
GEMINI_API_KEY=

# --- Files ---  local | gcs
STORAGE_BACKEND=local
STORAGE_DIR=./data/files
GCS_BUCKET=

# --- Other ---
TIMEZONE=Africa/Nairobi
PRIVACY_CONTACT_EMAIL=
SCREENING_WORKERS=2
SCREENING_DELAY_MS=1000
MAX_UPLOAD_MB=10
